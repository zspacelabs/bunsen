          "sha256": "c59271c284ae9c8335d795d60e0bfdb71aaaceec578d9bd9ffc1b8153c319ea1",
          "kind": "safetensors",
          "size": 1239748,
          "dtype": "float32"
        }
      ]
    }
  ]
}
