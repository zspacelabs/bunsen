{
  "kit": "silero",
  "name": "well-known",
  "description": "the Silero VAD checkpoints bunsen fetches by name",
  "groups": [
    {
      "name": "silero",
      "description": "snakers4/silero-vad, as upstream publishes it",
      "license": "MIT",
      "origin": "https://github.com/snakers4/silero-vad",
      "rows": [
        {
          "name": "vad-16k",
          "description": "Silero VAD, the 16 kHz model, from upstream's safetensors",
          "license": "MIT",
          "origin": "https://github.com/snakers4/silero-vad",
          "bundles": [
            "silero/vad-16k"
          ],
          "presets": {
            "presets": [
              {
                "name": "silero",
                "description": "upstream's get_speech_timestamps defaults: regions under 250 ms dropped, 100 ms of silence to close, 30 ms of padding",
                "patch": {
                  "vad": {
                    "min_silence_ms": 100,
                    "min_speech_ms": 250,
                    "speech_pad_ms": 30
                  }
                }
              },
              {
                "name": "faster-whisper",
                "description": "faster-whisper's VadOptions: no minimum region, 2000 ms of silence to close, 400 ms of padding",
                "patch": {
                  "vad": {
                    "min_silence_ms": 2000,
                    "min_speech_ms": 0,
                    "speech_pad_ms": 400
                  }
                }
              }
            ],
            "axes": [
              {
                "name": "vad-policy",
                "description": "how speech regions are cut from the VAD's probabilities",
                "members": [
                  "silero",
                  "faster-whisper"
                ]
              }
            ],
            "default": [
              "silero"
            ]
          }
        }
      ]
    }
  ],
  "bundles": [
    {
      "name": "silero/vad-16k",
      "description": "Silero VAD's 16 kHz model, upstream's safetensors",
      "license": "MIT",
      "origin": "https://github.com/snakers4/silero-vad",
      "namespace": "silero",
      "bases": [
        {
          "url": "https://raw.githubusercontent.com/snakers4/silero-vad/fb7d7c7f5df63235f0afd037d8397593829aeb41/src/silero_vad/data"
        }
      ],
      "resources": [
        {
          "key": "checkpoint",
